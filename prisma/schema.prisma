datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Product {
  id          String   @id @default(uuid())
  name        String   // 상품명
  category    String   // 카테고리
  price       Int      // 판매가
  stock       Int      // 재고 수량 (StockMovement 합계와 일치, DB CHECK >= 0)
  sku         String   @unique // 상품 코드 (SKU)
  baseUnit    ProductUnit @default(EA) // 기본단위 (재고 수량의 단위)
  boxQty      Int      @default(1)    // 박스당 입수 (BOX 단위 상품은 1)
  trackExpiry Boolean  @default(true) // 유통기한 관리 여부
  storageTemp StorageTemp @default(AMBIENT) // 보관 온도 (상온/냉장/냉동)
  safetyStock Int      @default(0)    // 안전재고 (현재고가 이 값 이하이면 '부족', DB CHECK >= 0)
  locationId  String?  @unique        // 기본 보관위치 (한 칸에 한 상품만)
  location    Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  status      ProductStatus @default(ACTIVE) // 직원 등록 = PENDING, 관리자 확정 후 ACTIVE (대기 상품은 입출고·주문 불가)
  createdById   String?
  createdBy     User?    @relation("ProductCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  confirmedById String?
  confirmedBy   User?    @relation("ProductConfirmedBy", fields: [confirmedById], references: [id], onDelete: Restrict)
  confirmedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  inbounds         Inbound[]
  outbounds        Outbound[]
  orderLines       TradeOrderLine[]
  stockMovements   StockMovement[]
  stockBalances    StockBalance[]
  locationHistory  ProductLocationHistory[]

  @@index([category, sku]) // 재고현황 분류 필터 + 코드순
  @@index([stock])         // 재고 없음 필터, 재고 적은 순 정렬
  @@index([status])
}

enum ProductStatus {
  PENDING // 등록 대기 (관리자 확정 전)
  ACTIVE  // 확정
  INACTIVE // 단종·비활성 (목록에서 숨김, 입출고·주문·위치 배정 불가, 이력은 보존)
}

enum StorageTemp {
  AMBIENT // 상온
  CHILLED // 냉장
  FROZEN  // 냉동
}

enum ProductUnit {
  EA  // 개
  BOX // 박스
  CAN // 캔
  L   // 리터
  KG  // 킬로그램
}

// 입고 기록 (1건 = 1상품 입고)
model Inbound {
  id         String   @id @default(uuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity   Int      // 입고 수량 (기본단위, 양수)
  unitCost   Int?     // 입고 단가 (원)
  partnerId  String?  // 공급처 (거래처 마스터)
  partner    Partner? @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  memo       String?  // 비고
  receivedAt DateTime @default(now()) // 입고일시
  version    Int      @default(0)     // 수정할 때마다 +1 (동시 수정 충돌 방지)
  requestId  String?  @unique         // 등록 요청 고유키 (같은 요청 이중 처리 차단)
  orderLineId String?                 // 발주 품목에서 입고 처리한 경우
  orderLine  TradeOrderLine? @relation(fields: [orderLineId], references: [id], onDelete: Restrict)
  status     InboundStatus @default(CONFIRMED) // 직원 등록 = PENDING (재고 미반영), 관리자 확정 시 재고 반영
  createdById   String?
  createdBy     User?     @relation("InboundCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  confirmedById String?
  confirmedBy   User?     @relation("InboundConfirmedBy", fields: [confirmedById], references: [id], onDelete: Restrict)
  confirmedAt   DateTime?
  cancelledById String?
  cancelledBy   User?     @relation("InboundCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)
  cancelledAt   DateTime?
  cancelReason  String?
  locationId String?                  // 넣을 위치 (비우면 확정 시점의 상품 기본 보관위치, 그것도 없으면 미지정)
  location   Location? @relation(fields: [locationId], references: [id], onDelete: Restrict)
  expiryDate DateTime? @db.Date        // 유통기한 (선택, 나중에 재고현황에서 입력 가능)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  stockMovements StockMovement[] // 원입고(INBOUND) 1건 + 정정(INBOUND_CORRECTION) n건 + 취소(INBOUND_CANCEL) — 칸이 나뉘면 칸마다 1건
  revisions      InboundRevision[]

  @@index([productId, receivedAt])
  @@index([partnerId])
  @@index([receivedAt])
  @@index([orderLineId])
  @@index([status, receivedAt])
}

enum InboundStatus {
  PENDING   // 등록 대기 (재고 미반영)
  CONFIRMED // 확정 (재고 반영)
  CANCELLED // 취소 (확정 후 취소, 재고 역이력)
}

enum StockMovementType {
  INBOUND  // 입고
  OUTBOUND // 출고
  ADJUST   // 재고조정
  INBOUND_CORRECTION  // 입고정정 (입고 수량 수정)
  OUTBOUND_CORRECTION // 출고정정 (출고 수량 수정)
  INBOUND_CANCEL      // 입고취소 (확정 입고 취소)
  OUTBOUND_CANCEL     // 출고취소 (확정 출고 취소, 재고 복원)
  EXPIRY_CHANGE       // 유통기한 변경 (같은 칸 안에서 -n/+n 한 쌍, 총재고 불변)
  MOVE                // 위치 이동 (A칸 -n / B칸 +n 한 쌍, 유통기한 유지, 총재고 불변)
}

// 칸별 재고: 상품 × 위치(null = 미지정) × 유통기한(null = 미상)
// 합계 == Product.stock. 변경은 changeStock 으로만. 0이 되면 행 삭제
// unique 는 NULLS NOT DISTINCT (마이그레이션 SQL에서 지정 → null 끼리도 한 행)
model StockBalance {
  id         String    @id @default(uuid())
  productId  String
  product    Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: Restrict)
  expiryDate DateTime? @db.Date
  lotDate    DateTime? @db.Date // 입고일(KST) — 선입선출 기준. null = 입고일 미상(이관된 기존 재고, 가장 먼저 출고)
  quantity   Int       // DB CHECK > 0
  updatedAt  DateTime  @updatedAt

  @@unique([productId, locationId, expiryDate, lotDate])
  @@index([locationId])
}

// 재고 변동 이력 (모든 재고 변경은 여기에 기록)
model StockMovement {
  id          String            @id @default(uuid())
  productId   String
  product     Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  type        StockMovementType
  quantity    Int               // 변동 수량 (입고 +, 출고 -)
  beforeStock Int               // 변경 전 재고
  afterStock  Int               // 변경 후 재고
  inboundId   String?
  inbound     Inbound?          @relation(fields: [inboundId], references: [id], onDelete: Restrict)
  outboundId  String?
  outbound    Outbound?         @relation(fields: [outboundId], references: [id], onDelete: Restrict)
  locationId  String?           // 변동된 칸의 위치 (null = 미지정)
  location    Location?         @relation(fields: [locationId], references: [id], onDelete: Restrict)
  expiryDate  DateTime?         @db.Date // 변동된 칸의 유통기한 (null = 미상)
  lotDate     DateTime?         @db.Date // 변동된 칸의 입고일 (null = 미상)
  createdAt   DateTime          @default(now())

  inboundRevision  InboundRevision?
  outboundRevision OutboundRevision?

  @@index([productId, createdAt])
  @@index([inboundId])
  @@index([outboundId])
}

// 입고 수정 기록 (누가 무엇을 왜 바꿨는지)
model InboundRevision {
  id              String         @id @default(uuid())
  inboundId       String
  inbound         Inbound        @relation(fields: [inboundId], references: [id], onDelete: Restrict)
  reason          String         // 수정 사유
  before          Json           // 변경 전 값 (바뀐 항목만)
  after           Json           // 변경 후 값 (바뀐 항목만)
  quantityDelta   Int            @default(0) // 수량 차이 (재고 증감량)
  stockMovementId String?        @unique // 수량 변경 시 생성된 정정 재고이력
  stockMovement   StockMovement? @relation(fields: [stockMovementId], references: [id], onDelete: Restrict)
  createdAt       DateTime       @default(now())

  @@index([inboundId, createdAt])
}

// 출고 기록 (1건 = 1상품 출고)
model Outbound {
  id         String   @id @default(uuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity   Int      // 출고 수량 (기본단위, 양수)
  unitPrice  Int?     // 출고 단가 (원, 기본값은 상품 판매가)
  partnerId  String?  // 출고처 (거래처 마스터)
  partner    Partner? @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  memo       String?  // 비고
  shippedAt  DateTime @default(now()) // 출고일시
  version    Int      @default(0)     // 수정할 때마다 +1 (동시 수정 충돌 방지)
  requestId  String?  @unique         // 등록 요청 고유키 (같은 요청 이중 처리 차단)
  orderLineId String?                 // 수주 품목에서 출고 처리한 경우
  orderLine  TradeOrderLine? @relation(fields: [orderLineId], references: [id], onDelete: Restrict)
  status     OutboundStatus @default(CONFIRMED) // 직원 등록 = PENDING (재고 미차감), 관리자 확정 시 재고 차감
  createdById   String?
  createdBy     User?     @relation("OutboundCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  confirmedById String?
  confirmedBy   User?     @relation("OutboundConfirmedBy", fields: [confirmedById], references: [id], onDelete: Restrict)
  confirmedAt   DateTime?
  cancelledById String?
  cancelledBy   User?     @relation("OutboundCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)
  cancelledAt   DateTime?
  cancelReason  String?
  // 출고 위치 지정: pickFixed=false 면 자동(유통기한 미상 → 빠른 순), true 면 이 칸에서만 출고 (부족하면 거부)
  // 칸 = pickLocationId(null 미지정) × pickExpiryDate(null 미상). 대기 건은 확정할 때 관리자가 바꿀 수 있음
  pickFixed      Boolean   @default(false)
  pickLocationId String?
  pickLocation   Location? @relation(fields: [pickLocationId], references: [id], onDelete: Restrict)
  pickExpiryDate DateTime? @db.Date
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  stockMovements StockMovement[] // 원출고(OUTBOUND) + 정정(OUTBOUND_CORRECTION) + 취소(OUTBOUND_CANCEL) — 칸이 나뉘면 칸마다 1건
  revisions      OutboundRevision[]
  dispatchItem   DispatchItem?      // 배차된 경우 (확정 출고만 배차 가능)

  @@index([productId, shippedAt])
  @@index([partnerId])
  @@index([shippedAt])
  @@index([orderLineId])
  @@index([status, shippedAt])
}

enum OutboundStatus {
  PENDING   // 등록 대기 (재고 미차감)
  CONFIRMED // 확정 (재고 차감)
  CANCELLED // 취소 (확정 후 취소, 재고 복원 역이력)
}

// 출고 수정 기록
model OutboundRevision {
  id              String         @id @default(uuid())
  outboundId      String
  outbound        Outbound       @relation(fields: [outboundId], references: [id], onDelete: Restrict)
  reason          String         // 수정 사유
  before          Json           // 변경 전 값 (바뀐 항목만)
  after           Json           // 변경 후 값 (바뀐 항목만)
  quantityDelta   Int            @default(0) // 출고 수량 차이 (재고 증감은 반대 부호)
  stockMovementId String?        @unique // 수량 변경 시 생성된 정정 재고이력
  stockMovement   StockMovement? @relation(fields: [stockMovementId], references: [id], onDelete: Restrict)
  createdAt       DateTime       @default(now())

  @@index([outboundId, createdAt])
}

// ───────── 창고 / 랙 / 구획 ─────────

enum StorageType {
  REFRIGERATED // 냉장
  FROZEN       // 냉동
  AMBIENT      // 실온
}

// 창고
model Warehouse {
  id          String      @id @default(uuid())
  code        String      @unique // 창고코드 (예: RF1, FZ2, AM1)
  name        String      // 창고명 (예: 냉장 1창고)
  storageType StorageType // 보관유형
  memo        String?
  isActive    Boolean     @default(true) // false = 비활성 (모든 칸을 새 위치로 지정 불가)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  racks     Rack[]
  locations Location[]
}

// 랙 (창고 안의 선반 1개)
model Rack {
  id           String    @id @default(uuid())
  warehouseId  String
  warehouse    Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  number       Int       // 랙 번호 (창고 안에서 1부터, 코드 R01)
  levels       Int       // 단 수
  binsPerLevel Int       // 단별 구획 수
  isActive     Boolean   @default(true) // false = 비활성 (이 랙의 칸을 새 위치로 지정 불가)
  createdAt    DateTime  @default(now())

  locations Location[]

  @@unique([warehouseId, number])
}

// 구획 (실제 물건을 놓는 위치 1칸)
model Location {
  id          String    @id @default(uuid())
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  rackId      String
  rack        Rack      @relation(fields: [rackId], references: [id], onDelete: Restrict)
  level       Int       // 단 (1 = 맨 아래)
  bin         Int       // 구획 (1 = 왼쪽부터)
  code        String    @unique // 위치코드 (예: RF1-R01-2-3)
  createdAt   DateTime  @default(now())

  product Product? // 이 칸을 기본 보관위치로 쓰는 상품
  stockBalances  StockBalance[]  // 이 칸에 실제로 있는 재고 (여러 상품 가능)
  stockMovements StockMovement[]
  inbounds       Inbound[]
  outboundPicks  Outbound[]      // 이 칸을 출고 위치로 지정한 출고

  @@unique([rackId, level, bin])
  @@index([warehouseId])
}

// 상품 보관위치 변경 이력 (직접 변경·교환·해제)
model ProductLocationHistory {
  id            String   @id @default(uuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  fromCode      String?  // 변경 전 위치코드 (없었으면 null)
  toCode        String?  // 변경 후 위치코드 (해제면 null)
  swappedWithSku String? // 자리를 서로 바꾼 상대 상품 코드
  reason        String?  // 사유
  createdAt     DateTime @default(now())

  @@index([productId, createdAt])
}

// ───────── 수발주 ─────────

enum TradeOrderType {
  PURCHASE // 발주 (공급처에 주문 → 입고)
  SALES    // 수주 (거래처 주문 → 출고)
}

enum TradeOrderStatus {
  OPEN      // 진행 전 (처리 수량 0)
  PARTIAL   // 일부 입고/출고
  DONE      // 전량 완료
  CLOSED    // 잔량 종결 (남은 수량 처리 안 함)
  CANCELLED // 취소 (처리 이력 없을 때만)
}

// 거래처 마스터 (공급처·출고처). 이름은 대소문자 무시로 중복 불가 (DB 유니크 인덱스 lower("name"))
enum PartnerType {
  SUPPLIER // 공급처 (입고·발주)
  CUSTOMER // 출고처 (출고·수주)
  BOTH     // 둘 다
}

model Partner {
  id        String      @id @default(uuid())
  name      String
  type      PartnerType
  isActive  Boolean     @default(true) // false = 새 입출고·주문에 선택 불가 (기존 기록은 유지)
  version   Int         @default(0)    // 수정할 때마다 +1 (동시 수정 충돌 방지)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  inbounds  Inbound[]
  outbounds Outbound[]
  orders    TradeOrder[]
}

// 발주서 / 수주서
model TradeOrder {
  id        String           @id @default(uuid())
  type      TradeOrderType
  orderNo   String           @unique // PO-20261001-001 / SO-20261001-001
  partnerId String           // 공급처(발주) 또는 거래처(수주) — 거래처 마스터
  partner   Partner          @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  status    TradeOrderStatus @default(OPEN)
  dueDate   DateTime?        // 입고 예정일 / 납기일 (KST 자정)
  memo      String?
  version   Int              @default(0)
  requestId String?          @unique // 등록 요청 고유키
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  lines TradeOrderLine[]

  @@index([type, status, createdAt])
  @@index([partnerId])
}

// 발주/수주 품목
model TradeOrderLine {
  id           String     @id @default(uuid())
  orderId      String
  order        TradeOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  seq          Int        // 품목 순서
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity     Int        // 주문 수량
  unitPrice    Int?       // 단가
  processedQty Int        @default(0) // 입고(발주) / 출고(수주) 처리된 수량

  inbounds  Inbound[]
  outbounds Outbound[]

  @@unique([orderId, productId])
  @@index([productId])
}

// ───────── 배차 ─────────

enum DispatchStatus {
  PLANNED    // 배차 (편성)
  LOADED     // 상차 완료
  IN_TRANSIT // 배송중
  DELIVERED  // 배송 완료
  CANCELLED  // 취소
}

// 차량
model Vehicle {
  id          String      @id @default(uuid())
  plateNo     String      @unique // 차량번호
  storageType StorageType // 적재 온도: 냉동 > 냉장 > 실온 (상위 온도 차량은 하위 상품도 실을 수 있음)
  driverName  String
  driverPhone String?
  memo        String?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  dispatches Dispatch[]
}

// 배차 (차량 1대의 배송 1회)
model Dispatch {
  id           String         @id @default(uuid())
  dispatchNo   String         @unique // DSP-20261001-001
  deliveryDate DateTime       // 배송일 (KST 자정)
  vehicleId    String
  vehicle      Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  status       DispatchStatus @default(PLANNED)
  memo         String?
  version      Int            @default(0)
  requestId    String?        @unique
  deliveredAt  DateTime?
  cancelledAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  items DispatchItem[]

  @@index([deliveryDate])
  @@index([vehicleId, deliveryDate])
}

// 배차에 실린 출고 건 (출고 1건은 배차 1곳에만)
model DispatchItem {
  id         String   @id @default(uuid())
  dispatchId String
  dispatch   Dispatch @relation(fields: [dispatchId], references: [id], onDelete: Restrict)
  outboundId String   @unique
  outbound   Outbound @relation(fields: [outboundId], references: [id], onDelete: Restrict)
  seq        Int      // 배송 순서
  createdAt  DateTime @default(now())

  @@index([dispatchId])
}

// ───────── 사용자 · 세션 ─────────

enum UserRole {
  STAFF // 직원: 상품등록·입고등록·출고등록 (대기 상태로)
  ADMIN // 관리자: 확정·취소·삭제·금액 보기·모든 메뉴
  WAREHOUSE // 입출고 담당: 입고·출고 등록·확정·수정·취소(금액 포함), 상품등록(대기), 재고 조회
  VIEWER // 조회 전용: 입고·출고 내역, 재고현황 조회만 (금액 제외)
}

model User {
  id           String   @id @default(uuid())
  loginId      String   @unique // 로그인 아이디 (소문자)
  name         String
  role         UserRole @default(STAFF)
  passwordHash String   // scrypt (modules/user/password.ts)
  isActive     Boolean  @default(true)
  version      Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions          Session[]
  productsCreated   Product[] @relation("ProductCreatedBy")
  productsConfirmed Product[] @relation("ProductConfirmedBy")
  inboundsCreated   Inbound[] @relation("InboundCreatedBy")
  inboundsConfirmed Inbound[] @relation("InboundConfirmedBy")
  inboundsCancelled Inbound[] @relation("InboundCancelledBy")
  outboundsCreated   Outbound[] @relation("OutboundCreatedBy")
  outboundsConfirmed Outbound[] @relation("OutboundConfirmedBy")
  outboundsCancelled Outbound[] @relation("OutboundCancelledBy")
}

// 로그인 시도 제한 (아이디별 연속 실패 횟수, 없는 아이디도 기록 · DB CHECK failCount >= 0)
model LoginThrottle {
  loginId     String    @id // 입력한 아이디 (소문자)
  failCount   Int       @default(0)
  lockedUntil DateTime? // 이 시각까지 로그인 차단
  updatedAt   DateTime  @updatedAt
}

// 로그인 세션 (쿠키에는 원본 토큰, DB에는 SHA-256 해시만 저장)
model Session {
  id        String   @id // 토큰 해시
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// ───────── 감사 로그 ─────────

enum AuditCategory {
  PRODUCT   // 상품
  INBOUND   // 입고
  OUTBOUND  // 출고
  STOCK     // 재고 (안전재고 등)
  WAREHOUSE // 창고·랙·보관위치
  ORDER     // 발주·수주
  DISPATCH  // 배차
  VEHICLE   // 차량
  USER      // 사용자·로그인
  PARTNER   // 거래처
  NOTICE    // 공지사항
}

// 모든 등록·수정·처리 작업 기록. 추가만 가능 (DB 트리거로 UPDATE·DELETE·TRUNCATE 차단)
model AuditLog {
  id          String        @id @default(uuid())
  category    AuditCategory
  action      String        // 작업 코드 (modules/audit/codes.ts AUDIT_ACTION_LABELS)
  targetId    String?       // 대상 레코드 id
  targetLabel String?       // 대상 표시값 (상품명, 주문번호 등)
  summary     String        // 작업 내용 (한국어 한 줄)
  detail      Json?         // 상세 값 (입력값·변경 전후 등)
  actorId     String?       // 작업자 id (FK 없음: 로그는 사용자와 무관하게 보존)
  actor       String?       // 작업자 표시 "이름(아이디)" (로그인 전 기록·시스템 작업은 null)
  createdAt   DateTime      @default(now())

  @@index([createdAt])
  @@index([category, createdAt])
}

// 공지사항 (관리자가 작성, 대시보드에 게시 중인 글만 표시). 삭제 없이 게시 중지로 내린다
model Notice {
  id          String   @id @default(uuid())
  title       String
  body        String
  isPinned    Boolean  @default(false) // 상단 고정
  isPublished Boolean  @default(true)  // false = 대시보드에서 숨김
  authorName  String   // 작성자 이름 (작성 시점 보존)
  version     Int      @default(0)     // 수정할 때마다 +1 (동시 수정 충돌 방지)
  requestId   String?  @unique         // 등록 요청 고유키
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished, isPinned, createdAt])
}
